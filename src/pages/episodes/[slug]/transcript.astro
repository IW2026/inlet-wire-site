---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const transcripts = (await getCollection("transcripts", ({ data }) => !data.draft));
  const episodes = await getCollection("episodes", ({ data }) => !data.draft);

  return transcripts.map((t) => {
    const ep = episodes.find((e) => e.slug === t.data.episode_slug);
    return {
      params: { slug: t.data.episode_slug },
      props: { transcript: t, ep },
    };
  });
}

type Props = {
  transcript: CollectionEntry<"transcripts">;
  ep: CollectionEntry<"episodes"> | undefined;
};
const { transcript, ep } = Astro.props as Props;
const { Content } = await transcript.render();

const artist = transcript.data.artist;
const episodeTitle = transcript.data.title ?? ep?.data.title ?? "";
const speakers = transcript.data.speakers;
const speakersLabel = speakers.join(" & ");

// "Interview Transcript" keeps this page from competing with the episode
// page for a plain artist-name search.
const pageTitle = `${artist} Interview Transcript`;
// Kept to 155 characters so Google shows it whole: what this page is,
// then the episode's own description, cut at a word boundary.
function clip(text: string, max = 155) {
  const clean = text.replace(/\*/g, "").replace(/\s+/g, " ").trim();
  if (clean.length <= max) return clean;
  return clean.slice(0, max - 1).replace(/[\s,;:.\u2014-]+\S*$/, "") + "…";
}
const pageDesc = transcript.data.seo_description ?? (ep
  ? clip(`Full transcript of Inlet Wire's conversation with ${artist}. ${ep.data.description}`)
  : clip(`Full transcript of Inlet Wire's conversation with ${artist}, from the BC music podcast hosted by Eric Chan.`));

// Reuse the episode's OG card so sharing a transcript link shows the episode art
const epNum = ep ? String(ep.data.episode_number).padStart(2, "0") : null;
const ogCard = epNum ? `/images/og/ep-${epNum}.jpg` : undefined;

const episodeUrl = `https://inletwire.com/episodes/${transcript.data.episode_slug}/`;
const transcriptUrl = `${episodeUrl}transcript/`;

// Ties the transcript to its episode so search engines treat it as the
// episode's companion text, not a separate competing page.
const transcriptJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${transcriptUrl}#webpage`,
  url: transcriptUrl,
  name: `${artist} — Transcript`,
  description: pageDesc,
  inLanguage: "en-CA",
  isPartOf: { "@id": "https://inletwire.com/#website" },
  about: { "@id": `${episodeUrl}#episode` },
  mainEntity: {
    "@type": "CreativeWork",
    name: `${artist} — Inlet Wire transcript`,
    isBasedOn: { "@id": `${episodeUrl}#episode` },
    author: { "@id": "https://inletwire.com/#eric-chan" },
    ...(transcript.data.transcribed_date
      ? { dateCreated: transcript.data.transcribed_date.toISOString() }
      : {}),
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",     item: "https://inletwire.com/" },
    { "@type": "ListItem", position: 2, name: "Episodes", item: "https://inletwire.com/episodes/" },
    { "@type": "ListItem", position: 3, name: artist,
      item: `https://inletwire.com/episodes/${transcript.data.episode_slug}/` },
    { "@type": "ListItem", position: 4, name: "Transcript",
      item: `https://inletwire.com/episodes/${transcript.data.episode_slug}/transcript/` },
  ],
};
---
<BaseLayout
  title={pageTitle}
  description={pageDesc}
  path={`/episodes/${transcript.data.episode_slug}/transcript/`}
  ogType="article"
  ogImage={ogCard}
  jsonLd={[transcriptJsonLd, breadcrumbJsonLd]}
>
  <article class="transcript-page" data-episode-slug={transcript.data.episode_slug}>

    <section class="hero">
      <div class="container prose">
        <div class="meta-line">Transcript{ep ? ` · Ep. ${ep.data.episode_number}` : ""}</div>
        <h1 style="margin-top: 0.5rem;">{artist}</h1>
        {episodeTitle && <p class="lede">{episodeTitle}</p>}
        <p class="transcript-speakers">Conversation between {speakersLabel}.</p>
        <p class="transcript-jump"><a href={`/episodes/${transcript.data.episode_slug}/`}>Listen to the episode</a></p>
      </div>
    </section>

    <section>
      <div class="container prose transcript-body">
        <Content />
      </div>
    </section>

    <section>
      <div class="container prose">
        <p class="transcript-fine">
          This transcript has been lightly edited for clarity and readability. Any transcription errors are ours.
        </p>
        <p style="margin-top: 2rem;">
          <a class="link" href={`/episodes/${transcript.data.episode_slug}/`}>← Back to episode</a>
        </p>
      </div>
    </section>

  </article>
</BaseLayout>
